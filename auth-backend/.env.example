# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

NODE_ENV=development
PORT=3000

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=auth_app
DB_PASSWORD=change-me
DB_NAME=auth_system

# Generate each secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# They must be at least 32 characters and different from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
