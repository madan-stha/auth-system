# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

NODE_ENV=development
PORT=3000

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=auth_app
DB_PASSWORD=change-me
DB_NAME=auth_system
# Start a local MySQL with these values:  docker compose up -d

# Generate each secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# They must be at least 32 characters and different from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# Seconds a just-rotated refresh token may be presented again without
# revoking the session (concurrent refreshes from two tabs). 0 = no grace.
REFRESH_REUSE_GRACE_SECONDS=10

# Per-IP rate limits over a window of RATE_LIMIT_TTL_SECONDS
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100
# Stricter limit for login and sign-up (brute-force protection)
AUTH_RATE_LIMIT_MAX=5

# Optional: password for admin@example.com created by `npm run seed`.
# If empty, a random password is generated and printed once.
SEED_ADMIN_PASSWORD=
